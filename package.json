{
  "name": "pathops-events",
  "version": "0.5.0",
  "private": true,
  "description": "The live-update channel of a PathOps Cell (Decision 0063): official Socket.IO with the PathOps token; internal publication by the Tenant Control Plane.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "express": "5.3.0",
    "jose": "6.2.17",
    "socket.io": "4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "selfsigned": "5.5.0",
    "socket.io-client": "4.8.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "5.1.0"
  }
}
